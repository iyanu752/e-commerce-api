# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_template

# Authentication
JWT_SECRET=change-me-before-production
JWT_EXPIRATION=7d

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
PAYSTACK_CURRENCY=NGN

# Redis
# Leave REDIS_HOST empty if you want the app to fall back to Nest's in-memory cache.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TTL=3600

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
